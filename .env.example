XAI_API_KEY=your_xai_api_key_here

# Email delivery for daily digest + weekly rollup (optional)
# For Proton Mail Bridge: SMTP_HOST=127.0.0.1, SMTP_PORT=1025
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=your_email@pm.me
SMTP_PASS=your_proton_bridge_password_here
EMAIL_TO=recipient@example.com

# Optional — path to a logo image for the PDF header.
# If unset or the file doesn't exist, falls back to a text wordmark (BRAND_NAME).
# LOGO_PATH=C:\path\to\logo.png

# Optional — wordmark text shown when no logo image is set. Default "AI Digest".
# BRAND_NAME=Acme Corp

# Optional — footer disclaimer text on the PDF report.
# Default "This report is AI-generated and may contain inaccuracies."
# REPORT_DISCLAIMER=Confidential — internal use only.

# Optional — days to keep digest/snapshot/urls files in output/ before
# auto-pruning on each run. Default 30.
# OUTPUT_RETENTION_DAYS=30
