GEMINI_API_KEY=your_gemini_api_key_here

# Email delivery for daily digest + weekly rollup (optional)
# For Proton Mail Bridge: SMTP_HOST=127.0.0.1, SMTP_PORT=1025
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=your_email@pm.me
SMTP_PASS=your_proton_bridge_password_here
EMAIL_TO=recipient@example.com

# Optional — path to a logo image for the PDF header.
# If unset or the file doesn't exist, falls back to a text "REDACTED_BRAND" wordmark.
# LOGO_PATH=C:\path\to\logo.png
